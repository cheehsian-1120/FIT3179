{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Dumbbell plot showing socio-economic disparities in medication dispensing.",
    "data": {
        "url": "pbs.csv"
    },
    "width": 650,
    "height": 300,
    "transform": [
        {
            "calculate": "trim(datum['Income Quintile'])",
            "as": "Income Quintile Clean"
        }
    ],
    "encoding": {
        "y": {
            "field": "Medications",
            "type": "nominal",
            "sort": "-x",
            "axis": {
                "title": "Medication Category",
                "titleFontSize": 16,
                "titleColor": "#000000",
                "titlePadding": 15,
                "labelFontSize": 14,
                "labelColor": "#000000",
                "labelPadding": 10,
                "labelLimit": 500,
                "grid": false,
                "ticks": false,
                "domain": true,
                "domainColor": "#000000",
                "domainWidth": 1
            }
        },
        "x": {
            "field": "Proportion (%)",
            "type": "quantitative",
            "title": "Per-Capita Dispensing Rate (%)",
            "axis": {
                "titleFontSize": 16,
                "titleColor": "#000000",
                "titlePadding": 15,
                "labelFontSize": 14,
                "labelColor": "#000000",
                "grid": false,
                "domainColor": "#000000"
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "line",
                "color": "#ced4da",
                "strokeWidth": 5
            },
            "encoding": {
                "detail": {
                    "field": "Medications",
                    "type": "nominal"
                }
            }
        },
        {
            "mark": {
                "type": "circle",
                "opacity": 1,
                "size": 350
            },
            "encoding": {
                "color": {
                    "field": "Income Quintile Clean",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "First quintile",
                            "Fifth quintile"
                        ],
                        "range": [
                            "#e63946",
                            "#457b9d"
                        ]
                    },
                    "legend": {
                        "title": "Socio-Economic Status",
                        "orient": "top",
                        "titleFontSize": 13,
                        "labelFontSize": 13,
                        "padding": 15
                    }
                },
                "tooltip": [
                    {
                        "field": "Medications",
                        "type": "nominal"
                    },
                    {
                        "field": "Income Quintile Clean",
                        "type": "nominal",
                        "title": "Quintile"
                    },
                    {
                        "field": "Proportion (%)",
                        "type": "quantitative",
                        "title": "Dispensing Rate (%)"
                    }
                ]
            }
        },
        {
            "mark": {
                "type": "text",
                "baseline": "middle",
                "fontSize": 13,
                "fontWeight": "bold",
                "align": {
                    "expr": "datum['Income Quintile Clean'] == 'First quintile' ? 'left' : 'right'"
                },
                "dx": {
                    "expr": "datum['Income Quintile Clean'] == 'First quintile' ? 15 : -15"
                }
            },
            "encoding": {
                "text": {
                    "field": "Proportion (%)",
                    "type": "quantitative",
                    "format": ".1f"
                },
                "color": {
                    "field": "Income Quintile Clean",
                    "type": "nominal",
                    "legend": null,
                    "scale": {
                        "domain": [
                            "First quintile",
                            "Fifth quintile"
                        ],
                        "range": [
                            "#e63946",
                            "#457b9d"
                        ]
                    }
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": "transparent"
        },
        "font": "Segoe UI, sans-serif"
    }
}