{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 800,
    "height": 600,
    "projection": {
        "type": "mercator",
        "center": [
            134,
            -28
        ],
        "scale": 860
    },
    "layer": [
        {
            "data": {
                "url": "australia_state.topojson",
                "format": {
                    "type": "topojson",
                    "feature": "STE_2021_AUST_GDA2020"
                }
            },
            "transform": [
                {
                    "lookup": "properties.STE_NAME21",
                    "from": {
                        "data": {
                            "url": "graph_4b.csv"
                        },
                        "key": "State & Territory",
                        "fields": [
                            "ASR"
                        ]
                    }
                },
                {
                    "calculate": "datum.properties.STE_NAME21",
                    "as": "state"
                }
            ],
            "params": [
                {
                    "name": "hover",
                    "select": {
                        "type": "point",
                        "on": "pointerover",
                        "fields": ["state"]
                    }
                }
            ],
            "mark": {
                "type": "geoshape"
            },
            "encoding": {
                "color": {
                    "field": "ASR",
                    "type": "quantitative",
                    "title": "ASR (per 100k)",
                    "scale": {
                        "type": "linear",
                        "domain": [
                            3.5,
                            5.0
                        ],
                        "scheme": "reds"
                    },
                    "legend": {
                        "title": "Age-Standardize Rate (per 100k)",
                        "orient": "bottom",
                        "direction": "horizontal",
                        "titleFontSize": 16,
                        "labelFontSize": 13,
                        "titleLimit": 500,
                        "gradientLength": 300,
                        "offset": 20
                    }
                },
                "tooltip": [
                    {
                        "field": "properties.STE_NAME21",
                        "title": "State/Territory",
                        "type": "nominal"
                    },
                    {
                        "field": "ASR",
                        "title": "Age-Standardised Rate",
                        "type": "quantitative",
                        "format": ".2f"
                    }
                ],
                "opacity": {
                    "condition": {"param": "hover", "value": 1},
                    "value": 0.3
                },
                "stroke": {
                    "condition": {"param": "hover", "empty": false, "value": "#000000"},
                    "value": "#000000"
                },
                "strokeWidth": {
                    "condition": {"param": "hover", "empty": false, "value": 2.5},
                    "value": 0.4
                }
            }
        },
        {
            "data": {
                "values": [
                    {"state": "Western Australia", "lon": 122.0, "lat": -25.0},
                    {"state": "Northern Territory", "lon": 133.5, "lat": -20.0},
                    {"state": "South Australia", "lon": 135.5, "lat": -30.0},
                    {"state": "Queensland", "lon": 144.0, "lat": -22.5},
                    {"state": "New South Wales", "lon": 147.0, "lat": -32.0},
                    {"state": "Victoria", "lon": 144.5, "lat": -36.8}
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 13,
                "fontWeight": "bold",
                "fill": "#333333"
            },
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "text": {"field": "state", "type": "nominal"},
                "opacity": {
                    "condition": {"param": "hover", "value": 1},
                    "value": 0.3
                }
            }
        },
        {
            "data": {
                "values": [
                    {"state": "Tasmania", "lon": 146.6, "lat": -41.5}
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 35,
                "dy": 15,
                "fontSize": 13,
                "fontWeight": "bold",
                "fill": "#333333"
            },
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "text": {"field": "state", "type": "nominal"},
                "opacity": {
                    "condition": {"param": "hover", "value": 1},
                    "value": 0.3
                }
            }
        },
        {
            "data": {
                "values": [
                    {"state": "Australian Capital Territory", "label": "Canberra", "lon": 150.3, "lat": -36}
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 30,
                "dy": -10,
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#333333"
            },
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "text": {"field": "label", "type": "nominal"},
                "opacity": {
                    "condition": {"param": "hover", "value": 1},
                    "value": 0.3
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "state": "Australian Capital Territory",
                        "start_lon": 149.0,
                        "start_lat": -35.4,
                        "end_lon": 152,
                        "end_lat": -35.5
                    }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#333333",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {"field": "start_lon", "type": "quantitative"},
                "latitude": {"field": "start_lat", "type": "quantitative"},
                "longitude2": {"field": "end_lon"},
                "latitude2": {"field": "end_lat"},
                "opacity": {
                    "condition": {"param": "hover", "value": 1},
                    "value": 0.3
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": "transparent"
        }
    }
}