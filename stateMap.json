                        "title": "Age-Standardize Rate (per 100k)",
                        "orient": "bottom",
                        "direction": "horizontal",
                        "titleFontSize": 16,
                        "labelFontSize": 13,
                        "titleLimit": 500,
                        "gradientLength": 300,
                        "offset": 20
                    }
