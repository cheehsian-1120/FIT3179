        "format": {
            "type": "topojson",
            "feature": "STE_2021_AUST_GDA2020"
        }
    },
    "transform": [
        {
            "lookup": "properties.STE_NAME21",
            "from": {
                "data": {
                    "url": "graph_4b.csv"
                },
                "key": "State & Territory",
                "fields": [
                    "ASR"
                ]
            }
        }
    ],
