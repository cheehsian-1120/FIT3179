{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": "transparent",
    "width": {"step": 50},
    "height": {"step": 50},
    "data": {
        "url": "https://raw.githubusercontent.com/cheehsian-1120/FIT3179/main/data/graph_3.csv"
    },
    "transform": [
        {
            "fold": [
                "Arthritis",
                "Asthma",
                "Dorsopathies",
                "Cancer",
                "Chronic Obstructive Pulmonary Disease",
                "Diabetes Mellitus",
                "Heart, Stroke and Vascular Disease",
                "Kidney Disease",
                "Mental and Behavioural Conditions",
                "Osteoporosis"
            ],
            "as": [
                "Secondary_Condition",
                "Probability"
            ]
        },
        {
            "calculate": "indexof(['Arthritis', 'Asthma', 'Dorsopathies', 'Cancer', 'Chronic Obstructive Pulmonary Disease', 'Diabetes Mellitus', 'Heart, Stroke and Vascular Disease', 'Kidney Disease', 'Mental and Behavioural Conditions', 'Osteoporosis'], datum['Comorbidity Condition'])",
            "as": "Primary_Index"
        },
        {
            "calculate": "indexof(['Arthritis', 'Asthma', 'Dorsopathies', 'Cancer', 'Chronic Obstructive Pulmonary Disease', 'Diabetes Mellitus', 'Heart, Stroke and Vascular Disease', 'Kidney Disease', 'Mental and Behavioural Conditions', 'Osteoporosis'], datum.Secondary_Condition)",
            "as": "Secondary_Index"
        },
        {
            "filter": "datum.Primary_Index > datum.Secondary_Index"
        }
    ],
    "encoding": {
        "x": {
            "field": "Secondary_Condition",
            "type": "nominal",
            "title": null,
            "sort": [
                "Arthritis",
                "Asthma",
                "Dorsopathies",
                "Cancer",
                "Chronic Obstructive Pulmonary Disease",
                "Diabetes Mellitus",
                "Heart, Stroke and Vascular Disease",
                "Kidney Disease",
                "Mental and Behavioural Conditions",
                "Osteoporosis"
            ],
            "axis": {
                "labelAngle": -45,
                "labelFontSize": {
                    "expr": "datum.value === 'Heart, Stroke and Vascular Disease' ? 16 : 15"
                },
                "labelLineHeight": 14,
                "labelAlign": "right",
                "labelFontWeight": {
                    "expr": "datum.value === 'Heart, Stroke and Vascular Disease' ? 'bold' : 'normal'"
                },
                "labelColor": {
                    "expr": "datum.value === 'Heart, Stroke and Vascular Disease' ? '#3d7a77' : '#555'"
                },
                "labelLimit": 500,
                "domain": false,
                "ticks": false
            }
        },
        "y": {
            "field": "Comorbidity Condition",
            "type": "nominal",
            "title": null,
            "sort": [
                "Arthritis",
                "Asthma",
                "Dorsopathies",
                "Cancer",
                "Chronic Obstructive Pulmonary Disease",
                "Diabetes Mellitus",
                "Heart, Stroke and Vascular Disease",
                "Kidney Disease",
                "Mental and Behavioural Conditions",
                "Osteoporosis"
            ],
            "axis": {
                "labelFontSize": {
                    "expr": "datum.value === 'Heart, Stroke and Vascular Disease' ? 16 : 15"
                },
                "labelLineHeight": 14,
                "labelFontWeight": {
                    "expr": "datum.value === 'Heart, Stroke and Vascular Disease' ? 'bold' : 'normal'"
                },
                "labelColor": {
                    "expr": "datum.value === 'Heart, Stroke and Vascular Disease' ? '#3d7a77' : '#555'"
                },
                "labelLimit": 500,
                "domain": false,
                "ticks": false
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rect",
                "stroke": "white",
                "strokeWidth": 2
            },
            "encoding": {
                "color": {
                    "field": "Probability",
                    "type": "quantitative",
                    "scale": {
                        "range": ["#e4ecea", "#699e9b", "#3d7a77"],
                        "domain": [
                            0,
                            50
                        ]
                    },
                    "legend": {
                        "title": "Probability (%)",
                        "orient": "right",
                        "titleFontSize": 15,
                        "titleColor": "#444",
                        "labelFontSize": 12,
                        "labelColor": "#555",
                        "gradientLength": 200
                    }
                },
                "tooltip": [
                    {
                        "field": "Comorbidity Condition",
                        "title": "Primary Condition"
                    },
                    {
                        "field": "Secondary_Condition",
                        "title": "Secondary Condition"
                    },
                    {
                        "field": "Probability",
                        "type": "quantitative",
                        "format": ".1f",
                        "title": "Probability (%)"
                    }
                ]
            }
        },
        {
            "mark": {
                "type": "text",
                "fontSize": 14,
                "fontWeight": "bold",
                "color": "white"
            },
            "encoding": {
                "text": {
                    "condition": {
                        "test": "(datum['Comorbidity Condition'] == 'Heart, Stroke and Vascular Disease' || datum.Secondary_Condition == 'Heart, Stroke and Vascular Disease') && datum.Probability > 30",
                        "field": "Probability",
                        "type": "quantitative",
                        "format": ".0f"
                    },
                    "value": ""
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": "transparent"
        }
    }
}